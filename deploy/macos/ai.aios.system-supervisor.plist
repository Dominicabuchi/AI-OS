<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.aios.system-supervisor</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/joseph/AI-OS/deploy/macos/aios-supervisor.sh</string>
  </array>

  <key>UserName</key>
  <string>joseph</string>

  <key>GroupName</key>
  <string>staff</string>

  <key>WorkingDirectory</key>
  <string>/Users/joseph/AI-OS</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/joseph</string>
    <key>USER</key>
    <string>joseph</string>
    <key>LOGNAME</key>
    <string>joseph</string>
