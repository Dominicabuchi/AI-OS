# ============================================================
# DEPLOYMENT SAFETY — NEVER COMMIT LOCAL RUNTIME/AUTH STATE
# ============================================================

# Persistent AI-OS runtime state
.ai-os-data/
**/.ai-os-data/

# AI-OS browser/session state at any workspace depth
**/.ai-os/
**/browser-profile/
**/browser-data/
**/user-data/

# Social/browser persistent state
**/reddit-data/
**/*storage-state*
**/*cookies*/
**/*sessions*/

# Credentials / key material
*.pem
*.key

# Generated source-adjacent compiler artifacts
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts
apps/**/src/**/*.js
apps/**/src/**/*.js.map
apps/**/src/**/*.d.ts

# Local dashboard backup
apps/dashboard/index.html.backup

# Generated compiler artifacts inside agent source trees
agents/**/src/**/*.js
agents/**/src/**/*.js.map
agents/**/src/**/*.d.ts

# Historical source snapshots / one-off backups
**/*.before-*
**/*.phase-a-backup
**/*.backup

# Verified non-runtime editor/build/history artifacts
*.swp
*.swo
**/*.phase*-backup
**/*.bak-*
**/*.pre-*

# Generated compiler artifacts inside example folders
**/examples/**/*.js
**/examples/**/*.js.map
**/examples/**/*.d.ts

# Verified obsolete backup files
*.bak
*.broken.bak

# Verified accidental empty file
packages/reddit-runtime/tsc

# Production deployment runtime state
production-data/
.env.production
